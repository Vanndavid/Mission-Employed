APP_NAME="Mission Employed"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# SQLite only. The PHP build used for this project has pdo_sqlite but NOT
# pdo_mysql, so MySQL/MariaDB are not an option locally. The path is relative
# to the backend/ directory; run `touch database/database.sqlite` before the
# first `php artisan migrate`.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# --- Sessions / cache / queue --------------------------------------------
# The API is stateless (Sanctum bearer tokens); sessions exist only for the
# few web routes Laravel ships with.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- CORS -----------------------------------------------------------------
# Origin(s) allowed to call /api/*. Comma-separate for more than one.
# The Vite dev server runs on :3000.
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS=http://localhost:3000,https://mission-employed.example

# --- Auth -----------------------------------------------------------------
# Personal access token lifetime in minutes; blank = never expire.
SANCTUM_TOKEN_EXPIRATION=

# --- Bootstrap admin ------------------------------------------------------
# `php artisan admin:bootstrap` creates or reconciles this account, and the
# container entrypoint runs it on every boot. It is how a deployment gets its
# first admin: registration always produces a free `user`, and only an admin
# can upgrade a plan. Leave either value empty to skip it entirely, which is
# what you want locally -- use `php artisan db:seed` for a dev admin instead.
#
# The environment is the source of truth, so the password is reset on every
# boot; changing it in the app does not stick. That is deliberate, and it is
# how you recover from being locked out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Mission Control"

# --- AI (ported in a later wave) -----------------------------------------
# Google Generative Language API key. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Database seeding (php artisan db:seed)
SEED_ADMIN_EMAIL=admin@mission-employed.test
SEED_ADMIN_PASSWORD=password
SEED_USER_EMAIL=user@mission-employed.test
SEED_USER_PASSWORD=password
