{
  "name": "mission-employed-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Mission-Employed API \u2014 track job applications and drive the AI features from an MCP client.",
  "bin": {
    "mission-employed-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
