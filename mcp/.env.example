# Where the Laravel API lives. The /api suffix is optional — both
# "http://localhost:8000" and "http://localhost:8000/api" work.
MISSION_EMPLOYED_API_URL=http://localhost:8000

# Optional. A Sanctum token to use instead of the `login` tool. When this is
# set it wins outright and nothing is written to disk.
# MISSION_EMPLOYED_TOKEN=

# Optional. Where `login` stores its token.
# MISSION_EMPLOYED_TOKEN_FILE=~/.config/mission-employed/token

# Optional. Model calls are slow; this matches the deployed nginx read timeout.
# MISSION_EMPLOYED_TIMEOUT_MS=300000

# Hosted mode only (`node dist/index.js --http`). Setting MCP_PUBLIC_URL turns
# on OAuth, so the server can be added to Claude or Cowork as a custom
# connector at <MCP_PUBLIC_URL>/mcp. Leave it unset for a local, unauthenticated
# endpoint.
# MCP_PUBLIC_URL=https://mission-employed.vanndavidteng.com
# At least 32 characters. Seals every client id, code and token; changing it
# signs every connector out. Generate one with: openssl rand -base64 48
# MCP_OAUTH_SECRET=
# PORT=8787
