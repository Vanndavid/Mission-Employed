.git
.github

# Frontend
frontend/node_modules
frontend/dist

# Backend (Laravel) — Dockerfile.laravel installs its own vendor/; keep a
# stray local vendor/ or sqlite file out of every build context.
backend/vendor
backend/node_modules
backend/database/*.sqlite
backend/storage/logs
backend/bootstrap/cache

# MCP server — built inside Dockerfile.mcp
mcp/node_modules
mcp/dist

*.log

# Never let a real environment file into a build context: it holds the
# Gemini key, APP_KEY and the admin credentials.
.env
.env.*
!.env.example
