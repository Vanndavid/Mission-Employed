.git
.github

# Frontend
frontend/node_modules
frontend/dist

# Backend (Laravel) — not yet part of the deployed stack, but keep it out of
# any build context so a stray vendor/ or sqlite file never ships.
backend/vendor
backend/node_modules
backend/database/*.sqlite
backend/storage/logs
backend/bootstrap/cache

# Express API (still the deployed backend until the Laravel cutover)
server/node_modules
server/data

*.log

# Never let a real environment file into the build context: vite.config.ts
# inlines GEMINI_API_KEY into the client bundle if it can see one.
.env
.env.*
!.env.example
